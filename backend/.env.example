# Cravelle Backend Environment Variables Example

# Server Port (Render sets this automatically)
PORT=8080

# Managed MySQL Database Connection
# Example Render/Aiven/PlanetScale/Railway JDBC URL:
DB_URL=jdbc:mysql://your-mysql-host:3306/cravelle?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=cravelle_admin
DB_PASSWORD=your_secure_db_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Security JWT Secret (min 256 bits / 32 bytes hex or base64)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
FRONTEND_URL=https://cravelle.vercel.app,http://localhost:5173

# AI Shopping Assistant (OpenAI-compatible LLM endpoint, Gemini, or Groq)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
